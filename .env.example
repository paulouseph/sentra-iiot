# Copy to .env and edit. Every value below is optional; these are the defaults.

# --- dataset -----------------------------------------------------------------
# Put the Edge-IIoTset CSV in data/. ML-EdgeIIoT-dataset.csv is the ~157k-row
# pre-sampled file and is the right choice unless you specifically need the
# full 2.2M-row DNN export.
SENTRA_DATASET_FILE=ML-EdgeIIoT-dataset.csv
# Cap rows when using the full corpus on a laptop (stratified subsample).
# SENTRA_MAX_ROWS=400000

# --- model -------------------------------------------------------------------
SENTRA_N_ESTIMATORS=300
SENTRA_MAX_DEPTH=24
# Below this confidence an alert is marked "needs a human" rather than acted on.
SENTRA_LOW_CONFIDENCE_THRESHOLD=0.55

# --- live stream -------------------------------------------------------------
SENTRA_STREAM_ENABLED=true
SENTRA_STREAM_INTERVAL_MS=1400
SENTRA_STREAM_ATTACK_RATIO=0.18

# --- server ------------------------------------------------------------------
SENTRA_HOST=127.0.0.1
SENTRA_PORT=8000
# Required as the X-API-Key header on anything that changes state.
# Set to an empty string to turn auth off for a classroom demo.
SENTRA_API_KEY=sentra-dev-key
